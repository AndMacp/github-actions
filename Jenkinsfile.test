pipeline {
    agent {
        docker {
            image 'mcr.microsoft.com/playwright:v1.56.1-noble'
        }
    }

    stages {
        stage('Setup') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Playwright Tests') {
            steps {
                sh 'npx playwright test'
            }
        }

        stage('Deploy') {
            steps {
                echo 'deploys project'
            }
        }
    }

    post {
        failure {
            archiveArtifacts(
                artifacts: 'playwright-report/**',
                allowEmptyArchive: true
            )
        }
    }
}